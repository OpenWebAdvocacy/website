{
  "name": "owa-website",
  "version": "1.0.1",
  "description": "",
  "main": ".eleventy.js",
  "type": "module",
  "scripts": {
    "clean": "npx rimraf ./dist",
    "serve": "npm run start",
    "start": "npx @11ty/eleventy --serve --quiet",
    "generate": "node generate-language-files.js",
    "build": "npm run production",
    "production": "npm run generate && NODE_ENV=production npx @11ty/eleventy",
    "serve:production": "npm run build && npx --yes http-server dist -p 8080 -c-1",
    "updates": "npx npm-check-updates -i --format group",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:debug": "npx playwright test --debug"
  },
  "engines": {
    "node": ">=26"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-cache-assets": "^2.3.0",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@sardine/eleventy-plugin-external-links": "^1.4.0",
    "clean-css": "^5.3.3",
    "cssnano": "^9.3.2",
    "eleventy-plugin-og-image": "^4.3.0",
    "eleventy-plugin-toc": "^1.1.5",
    "eleventy-plugin-youtube-embed": "^1.13.2",
    "globby": "^16.2.4",
    "html-minifier": "^4.0.0",
    "image-size": "^2.0.4",
    "jsdom": "^30.1.2",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "moment": "^2.31.0",
    "rgjs7": "^0.0.89"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "netlify-plugin-cache": "^1.0.3",
    "prettier": "^3.9.9"
  },
  "optionalDependencies": {
    "@resvg/resvg-js-darwin-arm64": "^2.6.2",
    "@resvg/resvg-js-linux-x64-gnu": "^2.6.2",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "sharp@0.34.5": true,
    "sharp@0.35.3": true
  }
}
