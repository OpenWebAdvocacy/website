{% set languages = languages_base.supported %}
{% set content = languages_base[page.lang] %}
<dialog class="language-dialog" closedby="any" aria-labelledby="language-dialog-title">
  <h2 id="language-dialog-title">{{ content.languages }}</h2>
  <ul>
    {% for language in languages %}
      <li>
        <a rel="alternate" hreflang="{{ language.code }}" lang="{{ language.code }}" href="{{ page.url | locale_url(language.code) | language(language.code, page.lang) }}">{{ language.name }}</a>
      </li>
    {% endfor %}
  </ul>
  <button type="button" class="action-button">{{ content.close }}</button>
</dialog>