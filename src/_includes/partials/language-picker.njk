{% set content = languages_base[page.lang] %}
<p>
  <button
    type="button"
    data-lang="{{ page.lang }}"
    aria-label="{{ content.languagePickerLabel1 }}{{ content.language }}{{ content.languagePickerLabel2 }}"
    class="language-picker">
    {% include "partials/globe.njk" %}
    {{ content.language }}
  </button>
</p>
