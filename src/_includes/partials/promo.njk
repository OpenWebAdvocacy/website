{% set content = languages_base[page.lang] %}

{% if page.url != ('/owa-promotional/' | locale_url) %}
  <div class="promo">
    <p class="illustration">
      <img src="/images/prom-gallery/sticker-applebrowserban-03.svg" loading="lazy" alt="{{ content.promoImageAlt }}" />
    </p>
    <div class="group">
      <h3><a href="{{ '/owa-promotional/' | locale_url }}">{{ content.promoHeading }}</a></h3>
      <p>{{ content.promoParagraph }}</p>
    </div>
  </div>
{% endif %}